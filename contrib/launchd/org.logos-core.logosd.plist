<?xml version="1.0" encoding="UTF-8"?>
<!--
  logosd as a launchd user agent (Tier 4b step 4b-6; DECISIONS G58, G146; docs/DAEMON.md §13).
  One per user session: logosd runs as its user, never as root. Install with
    cp org.logos-core.logosd.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.logos-core.logosd.plist
  The session is ~/.logos-core; create it first with `logosctl init`. The log is
  ~/Library/Logs/logosd.log. KeepAlive restarts logosd after a non-zero exit, exit 4 (the
  Module Loader failed) included; launchd's throttle spaces the restarts. ExitTimeOut is
  above the shutdown logosd waits for with the default deadlines.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.logos-core.logosd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.nix-profile/bin/logosd" 2&gt;&gt;"$HOME/Library/Logs/logosd.log"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ExitTimeOut</key>
  <integer>90</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
