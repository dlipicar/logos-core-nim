; -- metadata --
_module = "pmtest_module"

; Input for tests/generated/pmtest_module_*: the Package Manager's shell
; (src/logos_core/pm/shell.nim) hosted under a test name until 5-6a lifts the
; refusal of a hosted `logos_` provider (Tier 5 step 5-3b, F5; DECISIONS G405).
; Never shipped: 5-6a's `logos_package_manager` replaces it over the same
; shell. Its probe answers what the shell holds (tests/kit/pmtest_impl.nim).

pmtest.catalog = {
  sequence: uint64,
  digest: bstr .size 32,
  entries: uint64,
}

pmtest.binding = {
  name: tstr .size (1..64),
  instance: tstr .size (1..128),
  state: "idle" / "establishing" / "ready" / "renewing" / "backoff" / "stopped",
  ? route: tstr .size (1..256),
  ? readiness: "starting" / "ready" / "offline",
  ; how many routes the shell established for the binding
  established: uint64,
}

pmtest.status_request = {}

; The catalog in use, if any; each binding's route and readiness; the root
; operations still running.
pmtest.status_response = {
  ? catalog: pmtest.catalog,
  bindings: [* pmtest.binding],
  pending: uint64,
}

; One root operation for an exact version (PM §11): the driver's outcome.
pmtest.resolve_request = {
  name: tstr .size (1..256),
  version: tstr .size (1..256),
}

pmtest.selected = {
  package: tstr .size (1..256),
  version: tstr .size (1..256),
  schema_root: bstr .size 32,
  installed: bool,
}

pmtest.counters = {
  names: uint64,
  depth: uint64,
  attempts: uint64,
}

pmtest.resolve_response =
  { packages: [* pmtest.selected], counters: pmtest.counters } /
  { error: tstr .size (1..64), ? message: tstr .size (1..512) }

; [Tier 5 step 5-5-4; G449] The operations, each answering its §15 response value as
; pm/responses.nim encodes it (deterministic CBOR, in `response`); the invocation error
; MODULE_ERROR is the call's own failure. `source` is an encoded
; logos.package_manager.package_source.
pmtest.inspect_request = {
  ? package: tstr .size (1..256),
  ? version: tstr .size (1..256),
  ? source: bstr .size (1..8192),
}

pmtest.inspect_response = { response: bstr }

pmtest.install_request = {
  package: tstr .size (1..256),
  ? version: tstr .size (1..256),
  ? source: bstr .size (1..8192),
}

pmtest.install_response = { response: bstr }

pmtest.remove_request = {
  package: tstr .size (1..256),
  version: tstr .size (1..256),
}

pmtest.remove_response = { response: bstr }

; `update_package` with `current` = {package, version}.
pmtest.update_request = {
  package: tstr .size (1..256),
  version: tstr .size (1..256),
  ? target_version: tstr .size (1..256),
  ? source: bstr .size (1..8192),
}

pmtest.update_response = { response: bstr }

pmtest.handoff_request = {
  package: tstr .size (1..255),
  version: tstr .size (1..255),
  module: tstr .size (1..255),
}

pmtest.handoff_response = { response: bstr }
