; logos-core-nim.runtime-state.v2: the Runtime's persistent state (DECISIONS
; I82). One Logos deterministic-CBOR lcn.rs_state value in
; <store_dir>/runtime-state.cbor, written by runtime/store.nim and nothing else.
;
; Arrays may be empty here. The checks the schema cannot express (unique ids,
; intent fields, keys naming known instances, unshared state assignments) are
; applied when the store is read; a failure leaves the file as it is.
;
; The lcn.rs_record rules repeat host_config.cddl's lcn.app_module rules
; without `instance` and the configuration inputs (test_nimgen compares
; them), plus the accepted configuration binding's digest (DECISIONS I87).

; v2 (re-pin P5a; DECISIONS G357): completed_shutdown and enforced. A v1 store
; is read as a v2 store without them; it is always written as v2, which older
; builds refuse. completed_shutdown is present only in the snapshots a
; completed shutdown writes (RUNTIME l.3637): the next run's first write drops it.
lcn.rs_state = {
  format: "logos-core-nim.runtime-state.v1" / "logos-core-nim.runtime-state.v2",
  runtime_instance_id: tstr .size (1..128),
  epoch: uint64,
  instances: [* lcn.rs_instance],
  retired: [* lcn.rs_retired],
  create_keys: [* lcn.rs_create_key],
  ? completed_shutdown: true,
}

lcn.rs_instance = {
  instance: tstr .size (1..128),
  ? provider: tstr .size (1..128),
  source: "host" / "create_module",
  record: lcn.rs_record,
  state: "unloaded" / "loaded" / "ready" / "stopping" / "error",
  ? failure: lcn.rs_failure,
  revision: uint64,
  intent: "uninitialized" / "requested" / "stopped",
  ? intent_revision: uint64,
  ? origin: lcn.rs_origin,
  ? enforced: lcn.rs_failure,
}

; a classification as RUNTIME l.3605 spells it, loader-<code> included (l.3607).
; enforced: the classification an enforcement stop leaves when it completes
; (RUNTIME l.3613), kept aside while the instance is `stopping`.
lcn.rs_failure = {
  classification: tstr .size (1..64),
  ? reason: tstr .size (1..512),
}

lcn.rs_origin =
  { kind: "host" } /
  { kind: "instance", instance: tstr .size (1..128) }

; A retired host-assigned instance id, and the host-assigned state
; assignment it keeps reserved. Runtime-assigned names need no tombstone.
lcn.rs_retired = {
  instance: tstr .size (1..128),
  ? state_assignment: tstr .size (1..128),
}

; one create_module key association (RUNTIME l.3627-3628)
lcn.rs_create_key = {
  consumer: tstr .size (1..128),
  key: tstr .size (1..128),
  module: tstr .size (1..64),
  instance: tstr .size (1..128),
}

lcn.rs_record = {
  module: tstr .size (1..64),
  implementation: lcn.rs_implementation,
  ? primary_contract: logos.schema_commitment,
  ? implements: [* logos.schema_commitment],
  ? extends: [* logos.schema_commitment],
  ? requires: [* lcn.rs_requirement],
  ? requested_permissions: [* lcn.rs_permission],
  ? state_assignment: tstr .size (1..128),
  ? configuration_commitment: bstr .size 32,
}

lcn.rs_path = tstr .size (1..4096)

; hosted_dynamic: Tier 4b step 4b-3; a store holding it is refused by older
; builds. Nothing about a Module Host (pid, path, descriptor) is stored.
lcn.rs_implementation =
  { strategy: "direct_static", binding: tstr .size (1..128) } /
  { strategy: "direct_dynamic", artifact: lcn.rs_artifact } /
  { strategy: "hosted_dynamic", placement: "process", artifact: lcn.rs_artifact }

lcn.rs_artifact = {
  id: tstr .size (1..128),
  local_path: lcn.rs_path,
  hash: bstr .size 32,
  hash_suite: "logos.hash-suite.blake3-256",
}

lcn.rs_requirement = {
  contract: logos.schema_commitment,
  cardinality: "single" / "all-runtime-visible",
}

lcn.rs_permission = {
  permission: tstr .size (1..128),
  constraints: bstr .size (1..1048576),
  ? reason: tstr .size (1..512),
}

; one side record (runtime/store.nim putSide): the instance it belongs to
lcn.rs_side = {
  instance: tstr .size (1..128),
  value: bstr,
}

; [IMPL-DECISION I87] one configurable instance's configuration (side record
; kind `cfg`): the whole accepted binding, so an instance restores from its
; side record alone, and its state. Both are deterministic-CBOR CONFIG
; values (logos.module_configuration.schema_binding and
; .configuration_state), never the in-flight attempted record. The binding's
; blake3 digest is the instance record's configuration_commitment.
lcn.cfg_record = {
  binding: bstr,
  state: bstr,
  ? last_provisioned: bstr .size 32,
}

; [I93] one instance's permission settings (side record kind `prm`), present
; for every instance while a permission profile is selected
; (docs/PERMISSIONS.md): the logos.runtime_control.permission_settings_state
; it reports. The revision is at least 1 and failure is present only with
; failed (checked when it is read, runtime/settings.nim).
lcn.prm_record = {
  revision: uint64,
  permissions: [* lcn.rs_permission_setting],
  application: "pending" / "applied" / "failed",
  ? failure: "enforcement-failed",
}

lcn.rs_permission_setting = {
  permission: tstr .size (1..128),
  constraints: bstr .size (1..1048576),
}

; [IMPL-DECISION I96] where a transferred instance's state came from (side
; record kind `xfer`, keyed by the replacement): the deployment's
; state_transfers entry as applied (DECISIONS G305, G306). Written before the
; commit that creates the replacement; kept while the replacement is known or
; retired (RUNTIME l.3588); reaped at open only for an id neither is (a crash
; before the commit). bytes and files: copied, or 0 for a move, which reads
; nothing. epoch: the revision epoch of the start that applied it; at: Unix
; seconds.
lcn.xfer_record = {
  from: tstr .size (1..128),
  from_assignment: tstr .size (1..128),
  mode: "move" / "copy",
  bytes: uint64,
  files: uint64,
  epoch: uint64,
  at: uint64,
}
